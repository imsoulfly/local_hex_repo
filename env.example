## Phoenix
# Generate with: openssl rand -base64 48
SECRET_KEY_BASE=
LOG_LEVEL=info
PHX_HOST=localhost
PHX_URL_SCHEME=http
PHX_URL_PORT=4000

## LocalHex
LOCAL_HEX_REPO_NAME=local_hex
# Access Token for /api (provide either *_TOKEN or *_PATH)
LOCAL_HEX_AUTH_TOKEN=local_token
# LOCAL_HEX_AUTH_TOKEN_PATH=/run/secrets/local_hex_auth_token

# Storage: local|s3
LOCAL_HEX_STORE=local
# (used when LOCAL_HEX_STORE=local)
LOCAL_HEX_REPO_ROOT=/data/repos

# (required when LOCAL_HEX_STORE=s3)
# LOCAL_HEX_S3_BUCKET=your-bucket-name
# AWS_REGION=us-east-1
#
# Optional: IRSA (EKS) / AssumeRoleWithWebIdentity
# If set, LocalHex will configure ExAws to use ex_aws_sts web identity flow.
# AWS_ROLE_ARN=arn:aws:iam::123456789012:role/your-role
# AWS_WEB_IDENTITY_TOKEN_FILE=/var/run/secrets/eks.amazonaws.com/serviceaccount/token

# Key material (provide either *_PEM or *_PATH)
# LOCAL_HEX_PRIVATE_KEY_PEM="-----BEGIN ... -----END ..."
LOCAL_HEX_PRIVATE_KEY_PATH=/run/secrets/local_hex_private_key.pem
# LOCAL_HEX_PUBLIC_KEY_PEM="-----BEGIN ... -----END ..."
LOCAL_HEX_PUBLIC_KEY_PATH=/run/secrets/local_hex_public_key.pem

## Optional: Mirror
LOCAL_HEX_MIRROR_ENABLED=false
# required when LOCAL_HEX_MIRROR_ENABLED=true
# LOCAL_HEX_MIRROR_UPSTREAM_PUBLIC_KEY_PEM="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----\n"
# LOCAL_HEX_MIRROR_UPSTREAM_PUBLIC_KEY_PATH=/run/secrets/hexpm_upstream_public_key.pem
